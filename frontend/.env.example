# Copiar a .env.local para desarrollo (no versionar .env.local real)
# Requerido: sin esta variable, el frontend hace fetch relativo al mismo
# origen — funciona en producción (detrás del Load Balancer), pero en
# local (pnpm dev, sin Load Balancer) hay que apuntarlo al backend a mano.
VITE_API_URL=http://localhost:8080
